LARDER_POSTGRES_PASSWORD=replace-this
LARDER_SCAN_API_TOKEN=replace-this-too
LARDER_HOUSEHOLD_TIMEZONE=America/New_York
LARDER_OFF_USER_AGENT=Larder/0.1 (contact: you@example.com)
LARDER_UPCITEMDB_ENABLED=true
LARDER_UPCITEMDB_BASE_URL=https://api.upcitemdb.com/prod/trial
# Optional paid-plan credentials. Leave blank for the free trial endpoint.
LARDER_UPCITEMDB_USER_KEY=
LARDER_UPCITEMDB_KEY_TYPE=3scale
LARDER_LOG_LEVEL=INFO
LARDER_DIALOUT_GID=20
# Web UI (compose host port; CORS origins for the ng dev server; ISO 4217 price currency)
LARDER_WEB_PORT=8081
LARDER_WEB_CORS_ORIGINS=http://localhost:4200
LARDER_CURRENCY_CODE=USD
# Optional server-side ZipTax key. General address rates work on all plans;
# product-specific grocery/candy/etc. taxability requires ZipTax Pro.
LARDER_ZIPTAX_API_KEY=

# --- Authentik sign-in (only needed when Larder is reachable publicly) ---
# Off by default; every /v1/web route is open when this is false. The hardware
# scan API (/v1/scans) always uses LARDER_SCAN_API_TOKEN instead.
LARDER_OIDC_ENABLED=false
# Note the trailing slash: this is compared against the ID token's iss claim.
LARDER_OIDC_ISSUER=https://auth.example.com/application/o/larder/
LARDER_OIDC_CLIENT_ID=
LARDER_OIDC_CLIENT_SECRET=
# offline_access buys the refresh token used to revalidate long sessions.
# Drop it and a password change won't sign browsers out until the session ends.
LARDER_OIDC_SCOPES=openid profile email offline_access
# Comma-separated group names; blank means any account the provider admits.
LARDER_OIDC_ALLOWED_GROUPS=
# Public origin the browser sees. The callback defaults to
# {LARDER_PUBLIC_BASE_URL}/api/v1/web/auth/callback and must match the provider.
LARDER_PUBLIC_BASE_URL=
# HMAC key for the session cookie: openssl rand -hex 32. Rotating it signs
# everyone out. Not the same value as the OIDC client secret.
LARDER_SESSION_SECRET=
# One year, so an installed phone app never interrupts a shop to sign in. Safe
# because sessions are revocable rows and are re-proved on the interval below.
LARDER_SESSION_TTL_SECONDS=31536000
LARDER_SESSION_REVALIDATE_SECONDS=86400
# Keep this true behind HTTPS. Set it to false only for local HTTP testing.
LARDER_SESSION_COOKIE_SECURE=true

# Optional exact private origin for everyday use without login. Settings still
# require OIDC. Keep this distinct from the public tunnel's upstream hostname.
# LARDER_INTERNAL_BASE_URL=https://larder.example.internal
